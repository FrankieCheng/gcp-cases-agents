# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# CASE_AGENT_MODEL=gemini-4-hydrogen
# Optional: gemini-4-argon or gemini-4-carbon for deeper reasoning

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Feishu (open.feishu.cn) bot over long connection (WebSocket); no public endpoint needed.
# The bot starts only when BOTH are set. In production they come from Secret Manager
# (secrets FEISHU_APP_ID / FEISHU_APP_SECRET, wired by deployment/deploy_prod.sh). Never commit them.
# FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
# FEISHU_APP_SECRET=
# Optional: project used for bot conversations (default: first of ALLOWED_PROJECTS).
# FEISHU_DEFAULT_PROJECT=
# Optional: comma-separated chat_ids (oc_xxx) the bot serves; other chats are ignored.
# FEISHU_ALLOWED_CHAT_IDS=
# Optional: comma-separated Feishu open_ids (ou_xxx) of SRE Leads / Incident Commanders who can co-approve any draft card.
# FEISHU_ADMIN_OPEN_IDS=
# Optional: group messages without @ are routed using recent group context. While the bot is
# engaged in a chat (it spoke within FEISHU_CONTEXT_SECONDS, default 1800, or the sender @-ed it
# within FEISHU_FOLLOWUP_SECONDS, default 600), a Gemini check (same CASE_AGENT_MODEL) decides
# whether the message is for the bot. If that check fails, only the same user's follow-ups within
# the window are handled. Replies to the bot's own messages are always handled.
# Requires the group-messages scope. The context lives in memory only and is never logged.
# FEISHU_FOLLOWUP_SECONDS=600
# FEISHU_CONTEXT_SECONDS=1800

# Support API & Case Update Notification Settings
# SUPPORT_API_MODE=MOCK
# FORCE_TEST_CASE=true
# DEFAULT_SUBSCRIBER_EMAILS=
# CASE_POLL_INTERVAL_SECONDS=60
# Optional: comma-separated chat_ids (oc_xxx) to broadcast case updates when no explicit subscription exists.
# FEISHU_NOTIFY_CHAT_IDS=
# Optional: auto-discover active bot group chats via im/v1/chats when unsubscribed cases change (default: true).
# FEISHU_AUTO_NOTIFY_BOT_CHATS=true
# Optional: Feishu custom group bot webhook fallback (must be https://open.feishu.cn/... or https://open.larksuite.com/...).
# FEISHU_WEBHOOK_URL=
# FEISHU_WEBHOOK_SECRET=

